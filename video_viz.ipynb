    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "loaded_frames = np.load('frames.npy', allow_pickle=True)\n",
    "\n",
    "for frame in loaded_frames:\n",
    "    plt.imshow(frame)\n",
    "    plt.show()"
