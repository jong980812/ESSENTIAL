{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CIL Kinetics",
            "type": "python",
            "request": "launch",
            "module": "torch.distributed.launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "/data/bkh178/framework/VideoMAE_cil/",
            "args": [
                "--nproc_per_node",
                "1",
                "--master_port",
                "45859",
                "${workspaceFolder}/run_cil.py",
                "--model", "vit_base_patch16_224",
                "--data_set", "Kinetics-400",
                "--data_path", "data/kinetics_10_task",
                "--finetune", "/data/bkh178/pretrain/timesformer/videoMAE.pth",
                "--log_dir", "logs/test",
                "--all_tasks","10",
                "--output_dir", "logs/test",
                "--batch_size", "16",
                "--num_sample", "1",
                "--input_size", "224",
                "--short_side_size", "224",
                "--save_ckpt_freq", "10",
                "--num_frames", "16",
                "--sampling_rate", "4",
                "--opt", "adamw",
                "--lr", "1e-3",
                "--opt_betas", "0.9", "0.999",
                "--weight_decay", "0.05",
                "--epochs", "6",
                "--dist_eval",
                "--test_num_segment", "2",
                "--test_num_crop", "2",
                "--use_cls",
                "--enable_deepspeed",
            ],
            "env": {
                "OMP_NUM_THREADS": "1"
            }
        },
        {
            "name": "CIL UCF",
            "type": "python",
            "request": "launch",
            "module": "torch.distributed.launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "/data/bkh178/framework/VideoMAE_cil/",
            "args": [
                "--nproc_per_node",
                "1",
                "--master_port",
                "45859",
                "${workspaceFolder}/run_cil.py",
                "--model", "vit_base_patch16_224",
                "--data_set", "UCF101",
                "--data_path", "data/ucf_10_task",
                "--finetune", "/data/bkh178/pretrain/timesformer/videoMAE.pth",
                "--log_dir", "logs/test",
                "--all_tasks","10",
                "--output_dir", "logs/test",
                "--batch_size", "16",
                "--num_sample", "1",
                "--input_size", "224",
                "--short_side_size", "224",
                "--save_ckpt_freq", "50",
                "--num_frames", "16",
                "--sampling_rate", "4",
                "--opt", "adamw",
                "--lr", "5e-4",
                "--fc_drop_rate", "0.5",
                "--warmup_lr","1e-8",
                "--drop_path", "0.2",
                "--use_checkpoint",
                "--layer_decay","0.7",
                "--min_lr","1e-5",
                "--opt_betas", "0.9", "0.999",
                "--weight_decay", "0.05",
                "--epochs", "6",
                "--dist_eval",
                "--test_num_segment", "1",
                "--test_num_crop", "1",
                "--enable_deepspeed"
            ],
            "env": {
                "OMP_NUM_THREADS": "1"
            }
        }
    ]
}